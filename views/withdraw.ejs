<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Withdraw - Survey Rewards</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 min-h-screen">
  <nav class="bg-slate-800 text-white px-6 py-4 flex justify-between items-center shadow">
    <a href="/dashboard" class="text-xl font-bold">Survey Engine</a>
    <a href="/dashboard" class="bg-slate-700 px-3 py-1.5 rounded text-sm hover:bg-slate-600">Back to Dashboard</a>
  </nav>

  <div class="container mx-auto p-6 max-w-xl">
    <div class="bg-white p-8 rounded-lg shadow-sm border border-slate-200">
      <h2 class="text-2xl font-bold text-slate-800 mb-2">Request Cashout</h2>
      <p class="text-sm text-slate-500 mb-6">Current Balance: <strong class="text-blue-600"><%= user.points %> Points</strong> (Min Requirement: 1,000 Points)</p>

      <% if (error) { %>
        <div class="bg-red-100 text-red-700 p-3 rounded mb-4 text-sm"><%= error %></div>
      <% } %>
      <% if (success) { %>
        <div class="bg-green-100 text-green-700 p-3 rounded mb-4 text-sm"><%= success %></div>
      <% } %>

      <form action="/withdraw" method="POST" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Select Payment Method</label>
          <div class="grid grid-cols-2 gap-4">
            <label class="border p-3 rounded-md flex items-center cursor-pointer hover:bg-slate-50">
              <input type="radio" name="withdrawalType" value="FAUCETPAY" checked onclick="toggleFields('FAUCETPAY')" class="mr-2">
              <span class="text-sm font-semibold">FaucetPay (Instant)</span>
            </label>
            <label class="border p-3 rounded-md flex items-center cursor-pointer hover:bg-slate-50">
              <input type="radio" name="withdrawalType" value="BANK_TRANSFER" onclick="toggleFields('BANK_TRANSFER')" class="mr-2">
              <span class="text-sm font-semibold">Bank Transfer</span>
            </label>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Points to Redeem</label>
          <input type="number" name="points" min="1000" value="1000" required class="w-full px-3 py-2 border rounded-md focus:ring-2 focus:ring-blue-500">
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Currency Code</label>
          <input type="text" name="currency" value="BTC" placeholder="BTC, USDT, USD, NGN" required class="w-full px-3 py-2 border rounded-md">
        </div>

        <div id="faucetpay-fields">
          <label class="block text-sm font-medium text-slate-700 mb-1">FaucetPay Email / Wallet Address</label>
          <input type="text" name="faucetpayAddress" class="w-full px-3 py-2 border rounded-md">
        </div>

        <div id="bank-fields" class="space-y-4 hidden">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Full Name</label>
            <input type="text" name="fullName" class="w-full px-3 py-2 border rounded-md">
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Bank Name</label>
            <input type="text" name="bankName" class="w-full px-3 py-2 border rounded-md">
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Account Number</label>
            <input type="text" name="accountNumber" class="w-full px-3 py-2 border rounded-md">
          </div>
        </div>

        <button type="submit" class="w-full bg-blue-600 text-white py-2.5 rounded-md hover:bg-blue-700 font-medium transition">Submit Withdrawal</button>
      </form>
    </div>
  </div>

  <script>
    function toggleFields(type) {
      if (type === 'FAUCETPAY') {
        document.getElementById('faucetpay-fields').classList.remove('hidden');
        document.getElementById('bank-fields').classList.add('hidden');
      } else {
        document.getElementById('faucetpay-fields').classList.add('hidden');
        document.getElementById('bank-fields').classList.remove('hidden');
      }
    }
  </script>
</body>
</html>