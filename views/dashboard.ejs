<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Survey Rewards</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 min-h-screen flex flex-col">
  <nav class="bg-slate-800 text-white px-6 py-4 flex justify-between items-center shadow">
    <h1 class="text-xl font-bold">Survey Engine</h1>
    <div class="flex items-center space-x-4">
      <span class="text-slate-300">Welcome, <strong><%= user.username %></strong></span>
      <a href="/withdraw" class="bg-amber-500 text-slate-900 font-semibold px-3 py-1.5 rounded hover:bg-amber-400 transition text-sm">Withdraw</a>
      <a href="/logout" class="bg-red-600 px-3 py-1.5 rounded hover:bg-red-700 transition text-sm">Logout</a>
    </div>
  </nav>

  <main class="container mx-auto p-6 flex-grow">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-200">
        <p class="text-slate-500 text-sm font-medium">Available Balance</p>
        <p class="text-3xl font-extrabold text-blue-600 mt-2"><%= user.points %> Points</p>
      </div>
      <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-200">
        <p class="text-slate-500 text-sm font-medium">Total Earned Value</p>
        <p class="text-3xl font-extrabold text-green-600 mt-2">$<%= (user.points * 0.001).toFixed(2) %></p>
      </div>
      <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-200">
        <p class="text-slate-500 text-sm font-medium">Total Points Withdrawn</p>
        <p class="text-3xl font-extrabold text-purple-600 mt-2"><%= user.totalWithdrawn %> Points</p>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-slate-200 p-6">
      <h3 class="text-lg font-bold text-slate-800 mb-4">Complete Surveys & Offers</h3>
      <div class="w-full h-[750px] border rounded overflow-hidden">
        <iframe 
          src="https://timewall.io/offerwall?api_key=<%= timewallApiKey %>&user_id=<%= user._id %>" 
          class="w-full h-full border-0" 
          title="Timewall Offerwall">
        </iframe>
      </div>
    </div>
  </main>
</body>
</html>