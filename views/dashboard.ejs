<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Survey Rewards</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 min-h-screen flex flex-col">
  <nav class="bg-slate-800 text-white px-6 py-4 flex justify-between items-center shadow">
    <h1 class="text-xl font-bold">Survey Engine</h1>
    <div class="flex items-center space-x-4">
      <span class="text-slate-300">Welcome, <strong><%= user.username %></strong></span>
      <a href="/withdraw" class="bg-amber-500 text-slate-900 font-semibold px-3 py-1.5 rounded hover:bg-amber-400 transition text-sm">Withdraw</a>
      <a href="/logout" class="bg-red-600 px-3 py-1.5 rounded hover:bg-red-700 transition text-sm">Logout</a>
    </div>
  </nav>

  <main class="container mx-auto p-6 flex-grow">
    <!-- Balance & Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-200">
        <p class="text-slate-500 text-sm font-medium">Available Balance</p>
        <p class="text-3xl font-extrabold text-blue-600 mt-2"><%= user.points %> Points</p>
      </div>
      <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-200">
        <p class="text-slate-500 text-sm font-medium">Total Earned Value</p>
        <p class="text-3xl font-extrabold text-green-600 mt-2">$<%= (user.points * 0.001).toFixed(2) %></p>
      </div>
      <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-200">
        <p class="text-slate-500 text-sm font-medium">Total Points Withdrawn</p>
        <p class="text-3xl font-extrabold text-purple-600 mt-2"><%= user.totalWithdrawn %> Points</p>
      </div>
    </div>

    <!-- Native JSON Offer Grid Section -->
    <div class="bg-white rounded-lg shadow-sm border border-slate-200 p-6">
      <div class="flex justify-between items-center mb-6">
        <h3 class="text-xl font-bold text-slate-800">Available Tasks & Surveys</h3>
        <span class="text-sm bg-blue-50 text-blue-700 font-medium px-3 py-1 rounded-full"><%= offers.length %> Active Offers</span>
      </div>

      <% if (offers.length === 0) { %>
        <div class="text-center py-12 border-2 border-dashed border-slate-200 rounded-lg">
          <p class="text-slate-500 font-medium">No offers available right now. Please check back later!</p>
        </div>
      <% } else { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <% offers.forEach(function(offer) { %>
            <div class="border border-slate-200 rounded-xl p-5 hover:shadow-md transition flex flex-col justify-between bg-white">
              <div>
                <div class="flex items-center space-x-3 mb-3">
                  <img src="<%= offer.icon_url || 'https://via.placeholder.com/48' %>" alt="Offer Icon" class="w-12 h-12 rounded-lg object-cover bg-slate-100">
                  <div>
                    <h4 class="font-bold text-slate-800 line-clamp-1"><%= offer.title || offer.name %></h4>
                    <span class="text-xs bg-slate-100 text-slate-600 font-medium px-2 py-0.5 rounded"><%= offer.category || 'Survey' %></span>
                  </div>
                </div>
                <p class="text-xs text-slate-500 mb-4 line-clamp-2"><%= offer.description || 'Complete this task to earn points.' %></p>
              </div>

              <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
                <div>
                  <span class="block text-xs text-slate-400 font-medium">Reward</span>
                  <span class="text-lg font-extrabold text-green-600">+<%= offer.points || offer.reward %> PTS</span>
                </div>
                <a 
                  href="<%= offer.click_url || offer.url %>" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs px-4 py-2 rounded-lg transition"
                >
                  Start Task
                </a>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </main>
</body>
</html>