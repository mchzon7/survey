<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Survey Rewards</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Telegram WebApp SDK -->
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
</head>
<body class="bg-dark text-white min-vh-100 flex-column">

  <!-- Navigation -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-black border-bottom border-secondary px-4 py-3">
    <div class="container-fluid">
      <a class="navbar-brand font-weight-bold text-warning" href="/dashboard">Survey Engine</a>
      <div class="d-flex align-items-center gap-3">
        <span class="text-secondary">Welcome, <strong class="text-white"><%= user.username %></strong></span>
        <a href="/withdraw" class="btn btn-warning btn-sm font-weight-bold">Withdraw</a>
        <a href="/logout" class="btn btn-outline-danger btn-sm">Logout</a>
      </div>
    </div>
  </nav>

  <!-- Main Container -->
  <div class="container my-5" style="max-width: 800px;">

    <!-- User Stats Section -->
    <div class="row g-3 mb-4">
      <div class="col-md-4">
        <div class="card bg-black text-white border-secondary p-3">
          <span class="text-secondary small">Available Balance</span>
          <h4 class="text-warning mt-1 mb-0"><%= user.points %> Points</h4>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card bg-black text-white border-secondary p-3">
          <span class="text-secondary small">Total Earned Value</span>
          <h4 class="text-success mt-1 mb-0">$<%= (user.points * 0.001).toFixed(2) %></h4>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card bg-black text-white border-secondary p-3">
          <span class="text-secondary small">Withdrawn Points</span>
          <h4 class="text-info mt-1 mb-0"><%= user.totalWithdrawn %> Points</h4>
        </div>
      </div>
    </div>

    <!-- TimeWall Launch Card (Replaces the blocked iframe) -->
    <div class="card bg-dark text-white border-secondary p-4 mb-4 offerwall-section shadow-sm text-center">
      <h3 class="text-warning mb-3">Earn Free Points</h3>
      <p class="text-secondary mb-4">Complete tasks, surveys, and offers on TimeWall to earn instant points directly to your balance!</p>
      
      <button class="btn btn-outline-warning btn-lg w-100 font-weight-bold" onclick="openTimeWall()">
        Open TimeWall Tasks
      </button>
    </div>

  </div>

  <!-- JavaScript Popup Handler -->
  <script>
    function openTimeWall() {
      const userId = "<%= user._id %>";
      const offerwallUrl = `https://timewall.io/offerwall/12dcc9fe8ee59e3d?userID=${userId}`;

      // Opens in Telegram WebApp if present, or new browser window/tab to bypass third-party cookie blocking
      if (window.Telegram && window.Telegram.WebApp && window.Telegram.WebApp.initData) {
        window.Telegram.WebApp.openLink(offerwallUrl);
      } else {
        window.open(offerwallUrl, '_blank');
      }
    }
  </script>

</body>
</html>