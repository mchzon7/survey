<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Survey Rewards</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-dark text-white min-vh-100 d-flex flex-column">

  <!-- Top Navigation -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-black border-bottom border-secondary px-4 py-3">
    <div class="container-fluid">
      <a class="navbar-brand font-weight-bold text-warning" href="/dashboard">Survey Engine</a>
      <div class="d-flex align-items-center gap-3">
        <span class="text-secondary">Welcome, <strong class="text-white"><%= user.username %></strong></span>
        <a href="/withdraw" class="btn btn-warning btn-sm font-weight-bold">Withdraw</a>
        <a href="/logout" class="btn btn-outline-danger btn-sm">Logout</a>
      </div>
    </div>
  </nav>

  <!-- Main Content Container -->
  <div class="container my-4 flex-grow-1">

    <!-- User Stats Section -->
    <div class="row g-3 mb-4">
      <div class="col-md-4">
        <div class="card bg-black text-white border-secondary p-3">
          <span class="text-secondary small">Available Balance</span>
          <h4 class="text-warning mt-1 mb-0"><%= user.points %> Points</h4>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card bg-black text-white border-secondary p-3">
          <span class="text-secondary small">Total Earned Value</span>
          <h4 class="text-success mt-1 mb-0">$<%= (user.points * 0.001).toFixed(2) %></h4>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card bg-black text-white border-secondary p-3">
          <span class="text-secondary small">Withdrawn Points</span>
          <h4 class="text-info mt-1 mb-0"><%= user.totalWithdrawn %> Points</h4>
        </div>
      </div>
    </div>

    <!-- Correct TimeWall Embedded Section -->
    <div class="card bg-black text-white border-secondary p-3 shadow-sm">
      <h3 class="text-warning mb-3">Complete Offers & Surveys</h3>
      
      <div class="ratio ratio-16x9" style="min-height: 750px;">
        <iframe 
          src="https://timewall.io/offerwall/12dcc9fe8ee59e3d?userID=<%= user._id %>"  
          style="width: 100%; height: 100%; border: none; background: #ffffff; border-radius: 8px;"
          allow="clipboard-write; camera; microphone; geolocation"
          sandbox="allow-forms allow-modals allow-popups allow-popups-to-escape-sandbox allow-same-origin allow-scripts allow-top-navigation-by-user-activation"
          title="TimeWall Offerwall">
        </iframe>
      </div>
    </div>

  </div>

</body>
</html>