<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - Bank Withdrawals</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 min-h-screen p-8">
  <div class="max-w-6xl mx-auto bg-white p-6 rounded-lg shadow-sm">
    <h1 class="text-2xl font-bold text-slate-800 mb-6">Pending Bank Transfers</h1>
    
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b bg-slate-50 text-xs font-semibold text-slate-600 uppercase">
            <th class="py-3 px-4">User</th>
            <th class="py-3 px-4">Points</th>
            <th class="py-3 px-4">Value</th>
            <th class="py-3 px-4">Bank Details</th>
            <th class="py-3 px-4">Date</th>
            <th class="py-3 px-4 text-center">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y text-sm text-slate-700">
          <% if (withdrawals.length === 0) { %>
            <tr><td colspan="6" class="py-4 text-center text-slate-500">No pending requests found.</td></tr>
          <% } %>
          <% withdrawals.forEach(w => { %>
            <tr>
              <td class="py-3 px-4"><%= w.userId ? w.userId.username : 'Unknown' %></td>
              <td class="py-3 px-4 font-bold"><%= w.pointsRequested %></td>
              <td class="py-3 px-4 text-green-600">$<%= w.equivalentAmount.toFixed(2) %></td>
              <td class="py-3 px-4">
                <strong>Name:</strong> <%= w.details.fullName %><br>
                <strong>Bank:</strong> <%= w.details.bankName %><br>
                <strong>Acc:</strong> <%= w.details.accountNumber %>
              </td>
              <td class="py-3 px-4"><%= new Date(w.createdAt).toLocaleDateString() %></td>
              <td class="py-3 px-4 text-center">
                <form action="/admin/withdrawals/action" method="POST" class="inline-flex space-x-2">
                  <input type="hidden" name="withdrawalId" value="<%= w._id %>">
                  <button type="submit" name="action" value="APPROVE" class="bg-green-600 text-white px-3 py-1 rounded text-xs hover:bg-green-700">Approve</button>
                  <button type="submit" name="action" value="REJECT" class="bg-red-600 text-white px-3 py-1 rounded text-xs hover:bg-red-700">Reject</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>